{
  "name": "newsletter-unsubscriber-mac",
  "version": "1.0.0",
  "description": "A privacy-conscious macOS app for managing Microsoft mailbox newsletters.",
  "main": "./out/main/index.js",
  "author": "msmece",
  "homepage": "https://github.com/msmece/newsletter-unsubscriber-mac",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "scan:public": "node scripts/scan-public.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run scan:public && npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "electron": "44.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmece/newsletter-unsubscriber-mac.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  }
}
